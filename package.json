{
  "name": "rdotjson",
  "description": "Android String Resource XML (strings.xml) Parser",
  "version": "2.1.0",
  "author": "Yusuke Kawasaki <u-suke@kawa.net>",
  "bin": {
    "rdotjson": "./rdotjson.cli.js"
  },
  "bugs": {
    "url": "https://github.com/kawanet/rdotjson/issues"
  },
  "contributors": [
    "Yusuke Kawasaki <u-suke@kawa.net>",
    "Adriano Raiano <adriano@raiano.ch>"
  ],
  "dependencies": {
    "cheerio": "^1.2.0",
    "is-stream": "^2.0.1",
    "process.argv": "^1.0.0"
  },
  "devDependencies": {
    "jshint": "^2.13.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "*.js",
    "format",
    "gist",
    "lib"
  ],
  "homepage": "https://github.com/kawanet/rdotjson#readme",
  "jshintConfig": {
    "eqeqeq": true,
    "eqnull": true,
    "esversion": 6,
    "node": true,
    "undef": true,
    "unused": true,
    "varstmt": true
  },
  "keywords": [
    "Android",
    "CSV",
    "JSON",
    "Java",
    "R.string",
    "XML"
  ],
  "license": "MIT",
  "main": "./rdotjson.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawanet/rdotjson.git"
  },
  "scripts": {
    "fixpack": "fixpack",
    "jshint": "./node_modules/.bin/jshint .",
    "prepack": "npm test",
    "test": "npm run jshint && node --test test/*.js"
  }
}
